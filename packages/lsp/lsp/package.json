{
  "name": "@anotherharness/ah-lsp",
  "description": "Abstract LSP capability seam (ctx.lsp) for the AnotherHarness — language-server provider registry keyed by branded id and extension mapping, order-independent per-query selection, normalized definition/references/implementation/hover requests and results, and the LspError taxonomy",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/lsp/lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  }
}

{
  "name": "@anotherharness/ah-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by ah CLI, Web and agent tools",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/ah-app-boot": "workspace:*",
    "@anotherharness/ah-atomic-write": "workspace:*",
    "@anotherharness/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@anotherharness/ah-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-host-plugin-inventory": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/ah-hmr": "workspace:*",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anotherharness/ah-hmr": {
      "optional": true
    },
    "@anotherharness/ah-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@anotherharness/ah-package-manifest": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-host-plugin-inventory": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-hmr": "workspace:*",
    "@anotherharness/cordis-plugin-timer": "workspace:~",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*"
  }
}

{
  "name": "@anotherharness/ah-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the AnotherHarness web capability seam (ctx.web)",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-credentials": "workspace:*",
    "@anotherharness/ah-deepseek-account": "workspace:*",
    "@anotherharness/ah-launch-environment": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-web": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-credentials": "workspace:*",
    "@anotherharness/ah-credentials-local": "workspace:*",
    "@anotherharness/ah-deepseek-account": "workspace:*",
    "@anotherharness/ah-launch-environment": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-web": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anotherharness/ah-deepseek-account": {
      "optional": true
    }
  }
}

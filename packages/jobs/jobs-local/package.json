{
  "name": "@anotherharness/ah-jobs-local",
  "description": "Process-local implementation of the AnotherHarness background job registry seam",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-jobs": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis-plugin-include": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-jobs": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  }
}

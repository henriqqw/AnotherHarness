{
  "name": "@anotherharness/ah-acp",
  "description": "Automation-only Agent Client Protocol server for driving AnotherHarness agents over JSON-RPC stdio",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-mcp-client": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-persistence": "workspace:*",
    "@anotherharness/ah-token-meter": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anotherharness/ah-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-mcp-client": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-persistence": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-token-meter": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*"
  }
}

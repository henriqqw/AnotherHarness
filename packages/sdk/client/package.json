{
  "name": "@anotherharness/ah-sdk-client",
  "description": "TypeScript client SDK for driving an AnotherHarness runtime subprocess over stdio JSON-RPC: the AnotherHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/ah": "workspace:*"
  },
  "peerDependencies": {
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-sdk-protocol": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-sdk-protocol": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-experimental-translator": "workspace:*"
  }
}

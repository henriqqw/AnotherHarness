{
  "name": "@anotherharness/ah-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process AnotherHarness SDK clients",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-llm-deepseek-api-key": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-sdk-protocol": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-llm-deepseek-api-key": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-sdk-protocol": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*"
  }
}

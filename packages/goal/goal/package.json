{
  "name": "@anotherharness/ah-goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the AnotherHarness",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-bash-local": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-loader-smoke": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-checkpoint-policy": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  }
}

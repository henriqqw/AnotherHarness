{
  "name": "@anotherharness/ah-loader-smoke",
  "description": "Shared subprocess and direct-agent harness for keyless real-Loader example smoke tests",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/test-support/loader-smoke"
  },
  "type": "module",

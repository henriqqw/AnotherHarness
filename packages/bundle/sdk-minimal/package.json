{
  "name": "@anotherharness/ah-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "ah": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@anotherharness/cordis-plugin-timer": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop": "workspace:*",
    "@anotherharness/ah-deepseek-llm-api-extensions": "workspace:*",
    "@anotherharness/ah-jobs-local": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-llm-deepseek-api-key": "workspace:*",
    "@anotherharness/ah-llm-retry": "workspace:*",
    "@anotherharness/ah-mcp-resources": "workspace:*",
    "@anotherharness/ah-sandbox-local": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-sdk-app": "workspace:*",
    "@anotherharness/ah-sdk-jsonrpc-server": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-session-title": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-terminal": "workspace:*",
    "@anotherharness/ah-terminal-bash": "workspace:*",
    "@anotherharness/ah-tool-bash-persistent": "workspace:*",
    "@anotherharness/ah-tool-pwsh-persistent": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*",
    "@anotherharness/ah-tool-working-directory": "workspace:*",
    "@anotherharness/ah-fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~"
  }
}

  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-authorization": "workspace:*",
    "@anotherharness/ah-credentials": "workspace:*",
    "@anotherharness/ah-fs": "workspace:*",
    "@anotherharness/ah-launch-environment": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-llm-deepseek": "workspace:*",

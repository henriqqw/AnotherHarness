{
  "name": "@anotherharness/ah-host-directory-picker-native",
  "description": "Native-OS-chooser backend of the directory-picker seam for the AnotherHarness web GUI host",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/host/directory-picker-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/win32-dialog-worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/ah-host-directory-picker": "workspace:*",
    "@anotherharness/ah-native-command": "workspace:*",
    "koffi": "3.1.1"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "tsx": "^4.23.13"
  }
}

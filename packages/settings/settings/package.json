{
  "name": "@anotherharness/ah-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the AnotherHarness",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/schemastery": "workspace:~",
    "@anotherharness/cordis-plugin-timer": "workspace:~",
    "@anotherharness/ah-app-boot": "workspace:*",
    "@anotherharness/ah-hmr": "workspace:*",
    "@anotherharness/ah-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/ah-config-editor": "workspace:*",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}

{
  "name": "@anotherharness/ah-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-mcp-resources": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.2.0",
    "@anotherharness/ah-util-values": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-attachment-local": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "^4.4.3",
    "@anotherharness/ah-mcp-resources": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anotherharness/ah-mcp-resources": {
      "optional": true
    },
    "@anotherharness/ah-system-prompt": {
      "optional": true
    }
  }
}

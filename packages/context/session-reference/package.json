{
  "name": "@anotherharness/ah-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-compaction": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-output-retention": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-session-projection-cache": "workspace:*",
    "@anotherharness/ah-session-query": "workspace:*",
    "@anotherharness/ah-session-title": "workspace:*",
    "@anotherharness/ah-spill": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@anotherharness/ah-spill": {
      "optional": true
    },
    "@anotherharness/ah-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-include": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-compaction": "workspace:*",
    "@anotherharness/ah-fs-local": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-output-retention": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-session-projection-cache": "workspace:*",
    "@anotherharness/ah-session-query": "workspace:*",
    "@anotherharness/ah-session-query-sqlite": "workspace:*",
    "@anotherharness/ah-session-title": "workspace:*",
    "@anotherharness/ah-spill": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-spill-local": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-tool-fs": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*"
  }
}

{
  "name": "@anotherharness/ah-file-reference-local",
  "description": "Local-filesystem ctx.fileReferences provider with bounded fuzzy indexes",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/context/file-reference-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/types/search.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-file-reference": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-file-reference": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-working-directory": "workspace:*",
    "@anotherharness/ah-fs-local": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*"
  }
}

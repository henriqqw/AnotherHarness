{
  "name": "@anotherharness/ah-user-approval",
  "description": "User-approval seam (ctx.approval) for the AnotherHarness: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  }
}

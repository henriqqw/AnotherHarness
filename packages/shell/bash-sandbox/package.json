{
  "name": "@anotherharness/ah-bash-sandbox",
  "description": "Sandbox-consuming implementation of the AnotherHarness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-shell": "workspace:*",
    "@anotherharness/ah-bash-local": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/ah-shell": "workspace:*",
    "@anotherharness/ah-bash-local": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-local": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/node-addon-system": "workspace:~",
    "@anotherharness/ah-session-projection": "workspace:*"
  }
}

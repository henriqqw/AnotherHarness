{
  "name": "@anotherharness/ah-client-ui-session",
  "description": "Session Controller adapter for React and session-scoped slots",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/client/ui-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "ah": {
    "client": {
      "inject": [
        "@anotherharness/ah-api-remotes",
        "@anotherharness/ah-api-session-controller",
        "@anotherharness/ah-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-api-remotes": "workspace:*",
    "@anotherharness/ah-api-session-controller": "workspace:*",
    "@anotherharness/ah-client-store": "workspace:*",
    "@anotherharness/ah-client-test-runtime": "workspace:*",
    "@anotherharness/ah-client-ui-renderer": "workspace:*",
    "@anotherharness/ah-client-ui-slots": "workspace:*",
    "@anotherharness/ah-remote-mock": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

{
  "name": "@anotherharness/ah-client-ui-settings-general",
  "description": "Settings ownerless-copy and product onboarding plugin: the General section, shell trigger/header chrome content, settings dictionaries, and the versioned welcome notice",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/client/ui-settings-general"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "ah": {
    "client": {
      "inject": [
        "@anotherharness/ah-client-ui-settings",
        "@anotherharness/ah-client-locale",
        "@anotherharness/ah-client-connection",
        "@anotherharness/ah-api-remotes",
        "@anotherharness/ah-client-ui-sidebar",
        "@anotherharness/ah-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-api-remotes": "workspace:*",
    "@anotherharness/ah-client-connection": "workspace:*",
    "@anotherharness/ah-client-locale": "workspace:*",
    "@anotherharness/ah-client-store": "workspace:*",
    "@anotherharness/ah-client-test-runtime": "workspace:*",
    "@anotherharness/ah-client-ui-primitives": "workspace:*",
    "@anotherharness/ah-client-ui-renderer": "workspace:*",
    "@anotherharness/ah-client-ui-session": "workspace:*",
    "@anotherharness/ah-client-ui-settings": "workspace:*",
    "@anotherharness/ah-client-ui-sidebar": "workspace:*",
    "@anotherharness/ah-client-ui-slots": "workspace:*",
    "@anotherharness/ah-remote-mock": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@anotherharness/ah-settings": "workspace:*",
    "react-dom": "^18.2.0",
    "@anotherharness/ah-client-shortcuts": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

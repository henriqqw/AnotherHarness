{
  "name": "@anotherharness/ah-tools",
  "description": "Tool registry and execution pipeline for the AnotherHarness",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-ptc-runtime": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "dependencies": {
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-ptc-runtime": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*"
  }
}

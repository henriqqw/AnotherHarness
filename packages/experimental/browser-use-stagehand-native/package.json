{
  "name": "@anotherharness/ah-experimental-browser-use-stagehand-native",
  "description": "Experimental Stagehand browser tools with separately configured native models",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/experimental/browser-use-stagehand-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-browser-use": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@anotherharness/ah-experimental-browser-use-runtime": "workspace:*",
    "@anotherharness/ah-mcp-client": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@puppeteer/browsers": "3.2.2"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-include": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-attachment": "workspace:*",
    "@anotherharness/ah-attachment-local": "workspace:*",
    "@anotherharness/ah-browser-use": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "tsx": "^4.23.13"
  }
}

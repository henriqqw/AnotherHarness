{
  "name": "@anotherharness/ah-experimental-translator",
  "description": "Machine translation with reusable Session results",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/experimental/translator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-persistence": "workspace:*",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-credentials": "workspace:*",
    "@anotherharness/ah-launch-environment": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-app-boot": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-persistence": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-credentials": "workspace:*",
    "@anotherharness/ah-launch-environment": "workspace:*",
    "@anotherharness/ah-llm-deepseek": "workspace:*",
    "@anotherharness/ah-llm-deepseek-api-key": "workspace:*",
    "@anotherharness/ah-llm-deepseek-account": "workspace:*",
    "@anotherharness/ah-deepseek-account": "workspace:*",
    "@anotherharness/ah-deepseek-llm-api-extensions": "workspace:*",
    "@anotherharness/ah-session-log-deepseek": "workspace:*",
    "@anotherharness/ah-session-query-sqlite": "workspace:*"
  }
}

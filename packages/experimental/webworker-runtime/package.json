{
  "name": "@anotherharness/ah-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@anotherharness/ah-util-crypto": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.18.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.7",
    "readable-stream": "^4.7.0",
    "@anotherharness/ah-client-web": "workspace:*"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-client-connection": "workspace:*",
    "@anotherharness/ah-client-modules": "workspace:*",
    "@anotherharness/ah-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-api-gateway": "workspace:*",
    "@anotherharness/ah-app-boot": "workspace:*",
    "@anotherharness/ah-bash-sandbox": "workspace:*",
    "@anotherharness/ah-client-connection": "workspace:*",
    "@anotherharness/ah-client-file-upload": "workspace:*",
    "@anotherharness/ah-client-modules": "workspace:*",
    "@anotherharness/ah-host-webserver": "workspace:*",
    "@anotherharness/ah-sandbox-local": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/node-addon-system": "workspace:~",
    "@types/picomatch": "^4.0.3",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "^5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

{
  "name": "@anotherharness/ah-experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the AnotherHarness PTC execution seam",
  "version": "0.2.1-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"

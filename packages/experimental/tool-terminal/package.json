{
  "name": "@anotherharness/ah-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-terminal": "workspace:*",
    "@anotherharness/ah-output-retention": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-jobs": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/cordis-plugin-include": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-terminal": "workspace:*",
    "@anotherharness/ah-terminal-bash": "workspace:*",
    "@anotherharness/ah-output-retention": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-jobs": "workspace:*",
    "@anotherharness/ah-jobs-local": "workspace:*",
    "@anotherharness/ah-tool-jobs": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*"
  }
}

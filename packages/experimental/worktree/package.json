{
  "name": "@anotherharness/ah-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@anotherharness/schemastery": "workspace:~",
    "@anotherharness/ah-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-fs": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-fs": "workspace:*",
    "@anotherharness/ah-fs-local": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-local": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*"
  }
}

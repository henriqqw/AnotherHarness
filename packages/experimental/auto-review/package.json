{
  "name": "@anotherharness/ah-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the AnotherHarness Auto permission preset",
  "version": "0.2.1-alpha.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-instructions": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-permission-presets": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "dependencies": {
    "@anotherharness/ah-util-values": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-instructions": "workspace:*",
    "@anotherharness/ah-agent-loop": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*",
    "@anotherharness/ah-bash-sandbox": "workspace:*",
    "@anotherharness/ah-compaction": "workspace:*",
    "@anotherharness/ah-fs-local": "workspace:*",
    "@anotherharness/ah-fs-observation-policy": "workspace:*",
    "@anotherharness/ah-fs-sandbox": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-llm-deepseek": "workspace:*",
    "@anotherharness/ah-llm-deepseek-api-key": "workspace:*",
    "@anotherharness/ah-permission-presets": "workspace:*",
    "@anotherharness/ah-ptc-runtime-node": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-shell": "workspace:*",
    "@anotherharness/ah-shell-env": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-tool-bash": "workspace:*",
    "@anotherharness/ah-tool-fs": "workspace:*",
    "@anotherharness/ah-tool-subagent": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "ah": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

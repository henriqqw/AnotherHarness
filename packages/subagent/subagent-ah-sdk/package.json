{
  "name": "@anotherharness/ah-subagent-ah-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child AnotherHarness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/subagent/subagent-ah-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-sdk-client": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*"
  },
  "dependencies": {
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/cordis-plugin-loader": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-instructions": "workspace:*",
    "@anotherharness/ah-app-boot": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-llm-deepseek": "workspace:*",
    "@anotherharness/ah-llm-deepseek-api-key": "workspace:*",
    "@anotherharness/ah-loader-smoke": "workspace:*",
    "@anotherharness/ah-sdk-client": "workspace:*",
    "@anotherharness/ah-sdk-protocol": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-checkpoint-policy": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-skill-filesystem": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-tool-subagent": "workspace:*"
  }
}

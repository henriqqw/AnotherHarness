{
  "name": "@anotherharness/ah-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "ah": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@anotherharness/ah-brand": "workspace:*",
    "@anotherharness/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.4.3",
    "@anotherharness/ah-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-app-boot": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-loader-smoke": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-checkpoint-policy": "workspace:*",
    "@anotherharness/ah-session-persistence-jsonl": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-subagent-codex": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-tool-jobs": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/ah-agent-loop-testkit": "workspace:*"
  },
  "icon": "./icon.svg"
}

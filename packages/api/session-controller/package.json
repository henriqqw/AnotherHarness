    "@anotherharness/ah-file-reference": "workspace:*",
    "@anotherharness/ah-fs": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-llm-vision-bridge": "workspace:*",
    "@anotherharness/ah-native-command": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-session-persistence": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-session-projection-cache": "workspace:*",
    "@anotherharness/ah-session-query": "workspace:*",
    "@anotherharness/ah-session-title": "workspace:*",
    "@anotherharness/ah-settings": "workspace:*",
    "@anotherharness/ah-skill": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*",
    "@anotherharness/ah-typert-registry": "workspace:*",
    "@anotherharness/ah-util-time": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/ah-util-workspace-path": "workspace:*",
    "@anotherharness/ah-working-directory": "workspace:*",
    "@anotherharness/ah-workspace": "workspace:*",
    "@anotherharness/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {

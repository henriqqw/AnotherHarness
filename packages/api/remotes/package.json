{
  "name": "@anotherharness/ah-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "ah": {
    "client": {
      "inject": [
        "@anotherharness/ah-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@anotherharness/ah-deque": "workspace:*",
    "@anotherharness/ah-util-values": "workspace:*"
  },
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-scope": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-agent-preset-registry": "workspace:*",
    "@anotherharness/ah-api-gateway": "workspace:*",
    "@anotherharness/ah-api-job-controller": "workspace:*",
    "@anotherharness/ah-api-session-controller": "workspace:*",
    "@anotherharness/ah-api-settings-controller": "workspace:*",
    "@anotherharness/ah-api-workspace-controller": "workspace:*",
    "@anotherharness/ah-api-workspace-files": "workspace:*",
    "@anotherharness/ah-client-connection": "workspace:*",
    "@anotherharness/ah-client-file-upload": "workspace:*",
    "@anotherharness/ah-commands": "workspace:*",
    "@anotherharness/ah-cordis-host-runner": "workspace:*",
    "@anotherharness/ah-credentials": "workspace:*",
    "@anotherharness/ah-file-reference": "workspace:*",
    "@anotherharness/ah-goal": "workspace:*",
    "@anotherharness/ah-host-plugin-inventory": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-message-feedback": "workspace:*",
    "@anotherharness/ah-permission-presets": "workspace:*",
    "@anotherharness/ah-schedule": "workspace:*",
    "@anotherharness/ah-scope": "workspace:*",
    "@anotherharness/ah-session-reference": "workspace:*",
    "@anotherharness/ah-settings": "workspace:*",
    "@anotherharness/ah-subagent": "workspace:*",
    "@anotherharness/ah-typert-protocol": "workspace:*",
    "@anotherharness/ah-user-approval": "workspace:*",
    "@anotherharness/ah-user-questions": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "zod": "^4.4.3",
    "@anotherharness/ah-command-feedback": "workspace:*",
    "@anotherharness/ah-api-terminal-controller": "workspace:*",
    "@anotherharness/ah-plugin-manager": "workspace:*",
    "@anotherharness/ah-client-ui-plugin-manager": "workspace:*",
    "@anotherharness/ah-office-to-pdf": "workspace:*",
    "@anotherharness/ah-api-account-controller": "workspace:*",
    "@anotherharness/ah-deepseek-account": "workspace:*",
    "@anotherharness/ah-client-product-analytics": "workspace:*"
  }
}

    "@anotherharness/ah-tools": "workspace:*",
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@anotherharness/ah-agent": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-llm": "workspace:*",
    "@anotherharness/ah-output-retention": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-spill": "workspace:*",
    "@anotherharness/ah-system-prompt": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-tools": "workspace:*",

{
  "name": "@anotherharness/ah-ptc-runtime-node",
  "description": "Sandboxed Node process implementation of the AnotherHarness PTC execution capability",
  "version": "0.2.1-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henriqqw/AnotherHarness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-ptc-runtime": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-fs": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@anotherharness/ah-util-values": "workspace:*",
    "@anotherharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@anotherharness/cordis": "workspace:~",
    "@anotherharness/ah-ptc-runtime": "workspace:*",
    "@anotherharness/ah-session": "workspace:*",
    "@anotherharness/ah-timeout": "workspace:*",
    "@anotherharness/ah-fs": "workspace:*",
    "@anotherharness/ah-subprocess": "workspace:*",
    "@anotherharness/ah-sandbox": "workspace:*",
    "@anotherharness/ah-sandbox-policy": "workspace:*",
    "@anotherharness/ah-fs-local": "workspace:*",
    "@anotherharness/ah-subprocess-local": "workspace:*",
    "@anotherharness/ah-session-projection": "workspace:*",
    "@anotherharness/ah-sandbox-local": "workspace:*"
  }
}
